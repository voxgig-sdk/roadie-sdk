# Generated from the API definition and overwritten on every build: do not
# edit this file. Put customizations in the guide entry file, which includes
# this one and overrides its defaults:
#   guide.aontu

guide: {
  metrics: count: entity: 2
  metrics: count: path: 5
  metrics: count: method: 7

  entity: entity: {
    path: "/api/catalog/entities": {
      op: list: method: *GET
    }
    path: "/api/catalog/roadie-entities/entities": {
      op: create: method: *POST
      op: list: method: *GET
    }
    path: "/api/catalog/roadie-entities/entities/{entityId}": {
      rename: param: "entityId": *"id"
      op: load: method: *GET
      op: remove: method: *DELETE
    }
  }

  entity: entity_set: {
    path: "/api/catalog/roadie-entities/sets": {
      op: list: method: *GET
    }
    path: "/api/catalog/roadie-entities/sets/{setId}": {
      rename: param: "setId": *"set_id"
      op: update: method: *PUT
    }
  }

}
# Project overlay — YOURS. The scaffold creates this file once and never
# overwrites it, unlike every other file it writes.
#
# Everything else under model/ is toolchain-derived and is deliberately
# regenerated so that toolchain fixes propagate. Put anything here that is a
# decision about THIS project rather than a fact about the API.
#
# Included LAST by sdk.aon, after target/target-index.aon, because a key
# under main.kit.target.<t> can only refine a target that has already been
# defined. Declared earlier, the model build fails with "Cannot unify value:
# nil with value: string / key ext value was: nil", which names nothing that
# would lead you here.
#
# The release version each generated manifest declares (package.json,
# pyproject.toml, the gemspec, the rockspec) and that the port Makefiles tag:
#
#   main: kit: target: ts: publish: version: '1.2.3'
#
# Per target, because ports publish to different registries on different
# clocks. Set every target to the same value for a lockstep repo.
#
# A published package name that does not follow the derivation:
#
#   main: kit: target: ts: publish: registry: package: '@scope/name'
# outreach1 standard (2026-10-21): the Brontie build. std8 targets, the standard
# features, and a branded GitHub Pages documentation site.
main: kit: doc: edition: 'github-pages': active: true

# GitHub Pages is enabled for this repository, so generated documentation may
# link the site. Without this the README advertises no address, which is what
# an unpublished repository should do.
main: kit: doc: edition: 'github-pages': published: true

# Brand palette, taken from roadie.io's own stylesheet: #e9680c ember orange
# (--primary and --brand), #3dd4c8 teal (57 uses, the most-used accent),
# #f8f7f7 page background, #09090b text. Dark mode uses the site's own .dark
# values: #09090b background, #fafafa text.
# auto, so the dark values are actually used: light and dark emit one palette
# each, and only auto honours the reader's own setting.
main: kit: doc: style: mode: 'auto'

main: kit: doc: style: color: {
  primary: '#e9680c'
  accent: '#3dd4c8'
  background: '#f8f7f7'
  text: '#09090b'
  darkBackground: '#09090b'
  darkText: '#fafafa'
}

# Published package names, declared so a change in the generator's naming
# rule cannot rename a released package.
main: kit: target: ts: publish: registry: package: '@voxgig-sdk/roadie-sdk'
main: kit: target: py: publish: registry: package: 'voxgig-sdk-roadie-sdk'
main: kit: target: lua: publish: registry: package: 'voxgig-sdk-roadie-sdk'
main: kit: target: php: publish: registry: package: 'voxgig-sdk/roadie-sdk'
# --- cedar: release version (written by cedar-regen.sh, do not hand-edit)
# Per target, because sdkgen keys the version per target; identical across
# them because cedar tags a repo at one version.
main: kit: target: 'go': publish: version: '0.1.1'
main: kit: target: 'go-cli': publish: version: '0.1.1'
main: kit: target: 'go-mcp': publish: version: '0.1.1'
main: kit: target: 'lua': publish: version: '0.1.1'
main: kit: target: 'php': publish: version: '0.1.1'
main: kit: target: 'py': publish: version: '0.1.1'
main: kit: target: 'rb': publish: version: '0.1.1'
main: kit: target: 'ts': publish: version: '0.1.1'
# --- end cedar: release version
